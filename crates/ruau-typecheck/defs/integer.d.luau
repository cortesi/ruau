declare integer: {
    minsigned: number,
    maxsigned: number,

    create: @checked (value: number) -> number?,
    fromstring: @checked (value: string, radix: number?) -> number?,

    neg: @checked (value: number) -> number,
    add: @checked (left: number, right: number) -> number,
    sub: @checked (left: number, right: number) -> number,
    mul: @checked (left: number, right: number) -> number,
    div: @checked (left: number, right: number) -> number,
    idiv: @checked (left: number, right: number) -> number,
    udiv: @checked (left: number, right: number) -> number,
    urem: @checked (left: number, right: number) -> number,
    mod: @checked (left: number, right: number) -> number,
    rem: @checked (left: number, right: number) -> number,
    min: @checked (value: number, ...number) -> number,
    max: @checked (value: number, ...number) -> number,
    clamp: @checked (value: number, min: number, max: number) -> number,

    band: @checked (...number) -> number,
    bor: @checked (...number) -> number,
    bnot: @checked (value: number) -> number,
    bxor: @checked (...number) -> number,
    btest: @checked (...number) -> boolean,

    lt: @checked (left: number, right: number) -> boolean,
    le: @checked (left: number, right: number) -> boolean,
    ult: @checked (left: number, right: number) -> boolean,
    ule: @checked (left: number, right: number) -> boolean,
    gt: @checked (left: number, right: number) -> boolean,
    ge: @checked (left: number, right: number) -> boolean,
    ugt: @checked (left: number, right: number) -> boolean,
    uge: @checked (left: number, right: number) -> boolean,

    lshift: @checked (value: number, disp: number) -> number,
    rshift: @checked (value: number, disp: number) -> number,
    arshift: @checked (value: number, disp: number) -> number,
    lrotate: @checked (value: number, disp: number) -> number,
    rrotate: @checked (value: number, disp: number) -> number,
    extract: @checked (value: number, field: number, width: number?) -> number,
    replace: @checked (value: number, replacement: number, field: number, width: number?) -> number,
    countrz: @checked (value: number) -> number,
    countlz: @checked (value: number) -> number,
    bswap: @checked (value: number) -> number,
}
